{
  "extends": "../desktop/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/app/chat/right-rail/preview-pane": ["./src/preview-pane.tsx"],
      "@/app/settings/gateway-settings": ["./src/gateway-settings.tsx"],
      "@/contrib/runtime-loader": ["./src/runtime-loader.ts"],
      "@/lib/voice-client-direct": ["./src/voice-client-direct.ts"],
      "@/store/keep-awake": ["./src/keep-awake.ts"],
      "@/*": ["../desktop/src/*"],
      "@hermes/plugin-sdk": ["../desktop/src/sdk/index.ts"],
      "@hermes/shared/billing": ["../shared/src/billing-types.ts"],
      "@hermes/shared/*": ["../shared/src/*"],
      "@hermes/shared": ["../shared/src/index.ts"]
    },
    "incremental": false
  },
  "include": ["src", "../desktop/src/vite-env.d.ts", "../desktop/src/global.d.ts"],
  "exclude": ["dist", "tests"]
}
